# Database
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Payment provider (see src/lib/payment/README.md).
# Until a real gateway is configured, PAYMENT_PROVIDER=mock uses a
# fully-functional test provider that simulates success/failure so the
# checkout flow can be exercised end-to-end.
PAYMENT_PROVIDER="mock"

# When you're ready to go live, set PAYMENT_PROVIDER=stripe and provide:
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Platform defaults
DEFAULT_COMMISSION_PERCENT="10"
PLATFORM_CURRENCY="LSL"

# Courier/shipment tracking (see src/lib/courier/README-equivalent doc
# comment in CourierProvider.ts). COURIER_PROVIDER=mock uses a
# fully-functional test provider so the tracking UI can be exercised
# end-to-end. Swap to a real carrier id once you've implemented and
# registered a provider class for it.
COURIER_PROVIDER="mock"

# AI-assisted customer support (src/lib/ai). Optional — leave unset and
# /api/ai/support will tell users AI support isn't configured yet rather
# than faking a response. Set this to enable real Claude-powered support
# grounded in the customer's actual order data.
# ANTHROPIC_API_KEY=""

# Shared secret for triggering automated vendor payouts from an external
# scheduler (Vercel Cron / GitHub Actions / OS cron) without an admin
# session — see src/app/api/admin/payouts/auto-run/route.ts.
# CRON_SECRET=""


# Where uploaded product images are stored (see src/lib/uploads.ts).
# Defaults to <project>/storage/uploads. Add "storage/" to .gitignore.
# Local disk is fine for dev or a single server; switch to object storage
# (e.g. Cloudflare R2) before deploying to a serverless host.
# UPLOAD_DIR=""

# Encrypts vendors' M-Pesa API keys at rest (src/lib/secrets.ts).
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: if it's lost or changed, vendors must re-enter their keys.
PAYMENT_CREDENTIALS_KEY=""

# Optional override of the Vodacom M-Pesa Open API host (src/lib/mpesa).
# MPESA_API_HOST="https://openapi.m-pesa.com"

# MoPay (src/lib/mopay). Vendors enter their own MoPay project API keys in
# their dashboard; nothing marketplace-wide is needed except where MoPay
# should send customers back. MoPay expects an https:// URL, so for local
# testing use a tunnel (e.g. cloudflared or ngrok) and put its URL here.
# Falls back to NEXTAUTH_URL.
# PUBLIC_APP_URL="https://your-tunnel.example.com"
# MOPAY_API_HOST="https://mopay.co.ls"
