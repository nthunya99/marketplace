// Multi-Vendor Marketplace — Phase 1 schema
// Covers: auth/roles, vendor approval, categories, products + variants,
// inventory, cart, multi-vendor orders, payments, commissions.
// Later phases (reviews, chat, coupons, loyalty, affiliates, audit logs,
// etc.) extend this schema without needing to rewrite these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Auth / Roles
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 1:1 profile depending on role
  vendorProfile VendorProfile?
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]          @relation("CustomerOrders")
  productReviews ProductReview[]
  vendorReviews  VendorReview[]
  notifications  Notification[]
  returnRequests ReturnRequest[]
  loyaltyAccount LoyaltyAccount?
  recentlyViewed RecentlyViewed[]
  conversationsAsCustomer Conversation[] @relation("ConversationCustomer")
  messages       Message[]
  couponRedemptions CouponRedemption[]

  @@index([role])
}

// ---------------------------------------------------------------------
// Vendors
// ---------------------------------------------------------------------

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model VendorProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName        String
  storeSlug        String       @unique
  storeDescription String?
  logoUrl          String?
  bannerUrl        String?
  contactEmail     String?
  contactPhone     String?

  status        VendorStatus @default(PENDING)
  isVerified    Boolean      @default(false)

  // Commission override; falls back to platform default when null.
  commissionPercent Decimal? @db.Decimal(5, 2)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  products      Product[]
  vendorOrders  VendorOrder[]
  wallet        VendorWallet?
  payouts       Payout[]
  reviews       VendorReview[]
  shippingMethods ShippingMethod[]
  conversations   Conversation[]
  coupons         Coupon[]

  @@index([status])
}

model VendorWallet {
  id               String        @id @default(cuid())
  vendorId         String        @unique
  vendor           VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  pendingBalance   Decimal       @default(0) @db.Decimal(12, 2)
  availableBalance Decimal       @default(0) @db.Decimal(12, 2)
  totalEarnings    Decimal       @default(0) @db.Decimal(12, 2)
  totalCommission  Decimal       @default(0) @db.Decimal(12, 2)
  totalWithdrawn   Decimal       @default(0) @db.Decimal(12, 2)

  updatedAt        DateTime      @updatedAt
}

// ---------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  isDefault  Boolean  @default(false)

  createdAt  DateTime @default(now())

  orders     Order[]
}

// ---------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")

  products    Product[]
  coupons     Coupon[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

// ---------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  vendorId         String
  vendor           VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])

  name             String
  slug             String        @unique
  description      String
  shortDescription String?

  // Base price/stock used when the product has no variants.
  price            Decimal       @db.Decimal(12, 2)
  discountPrice    Decimal?      @db.Decimal(12, 2)
  sku              String        @unique
  stockQuantity    Int           @default(0)
  lowStockThreshold Int          @default(5)

  brand            String?
  weightKg         Decimal?      @db.Decimal(8, 3)
  lengthCm         Decimal?      @db.Decimal(8, 2)
  widthCm          Decimal?      @db.Decimal(8, 2)
  heightCm         Decimal?      @db.Decimal(8, 2)
  tags             String[]      @default([])

  status           ProductStatus @default(DRAFT)

  images           ProductImage[]
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  reviews          ProductReview[]
  recentlyViewedBy RecentlyViewed[]
  conversations    Conversation[]
  coupons          Coupon[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
}

// A variant represents a specific combination (e.g. Size=M, Color=Red)
// and carries its own SKU/price/stock/image, per spec section 3.
model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku           String      @unique
  optionsJson   Json        // e.g. {"Size":"M","Color":"Red"}
  price         Decimal     @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  imageUrl      String?

  cartItems     CartItem[]
  orderItems    OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
}

// ---------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int             @default(1)
  createdAt DateTime        @default(now())

  @@unique([cartId, productId, variantId])
}

// ---------------------------------------------------------------------
// Orders (parent order + per-vendor sub-orders, per spec section 7)
// ---------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  INITIATED
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

// The parent order = the customer's single checkout.
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique

  customerId    String
  customer      User        @relation("CustomerOrders", fields: [customerId], references: [id])

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])

  subtotal      Decimal     @db.Decimal(12, 2)
  shippingTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  couponCode    String?
  loyaltyPointsRedeemed Int @default(0)
  loyaltyPointsEarned   Int @default(0)
  grandTotal    Decimal     @db.Decimal(12, 2)

  status        OrderStatus @default(PENDING)

  vendorOrders  VendorOrder[]
  payment       Payment?
  fraudFlag     FraudFlag?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
}

// One VendorOrder per vendor represented in the parent Order.
model VendorOrder {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId      String
  vendor        VendorProfile @relation(fields: [vendorId], references: [id])

  subtotal      Decimal     @db.Decimal(12, 2)
  commissionPercent Decimal @db.Decimal(5, 2)
  commissionAmount  Decimal @db.Decimal(12, 2)
  vendorEarnings    Decimal @db.Decimal(12, 2)

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingCost     Decimal     @default(0) @db.Decimal(12, 2)

  refundedAmount    Decimal     @default(0) @db.Decimal(12, 2)

  status        OrderStatus @default(PENDING)
  trackingNumber String?
  courierProvider String? // e.g. "mock", "dhl" — which CourierProvider to query for tracking

  items         OrderItem[]
  returnRequests ReturnRequest[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([orderId])
  @@index([vendorId])
}

model OrderItem {
  id            String          @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  productId     String
  product       Product         @relation(fields: [productId], references: [id])

  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Decimal   @db.Decimal(12, 2)
  quantity            Int

  lineTotal           Decimal   @db.Decimal(12, 2)

  returnRequests      ReturnRequest[]
}

// ---------------------------------------------------------------------
// Payments / Transactions
// ---------------------------------------------------------------------

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider      String        // e.g. "mock", "stripe"
  providerRef   String?       // external charge/payment intent id
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("LSL")
  status        PaymentStatus @default(INITIATED)

  transactions  Transaction[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  type      String   // "charge" | "refund" | "payout"
  amount    Decimal  @db.Decimal(12, 2)
  status    String
  metaJson  Json?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
// Payouts — vendors request withdrawals from their available balance;
// admins approve/reject/complete (spec section 10).
// ---------------------------------------------------------------------

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

model Payout {
  id          String        @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(12, 2)
  status      PayoutStatus  @default(REQUESTED)
  adminNote   String?

  requestedAt DateTime      @default(now())
  processedAt DateTime?

  @@index([vendorId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Wishlist (spec section 14)
// ---------------------------------------------------------------------

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ---------------------------------------------------------------------
// Reviews & ratings (spec section 15)
// ---------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating           Int          // 1-5
  title            String?
  body             String?
  images           String[]     @default([])
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  reportCount      Int          @default(0)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([status])
}

model VendorReview {
  id        String       @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating    Int
  body      String?
  status    ReviewStatus @default(PENDING)
  reportCount Int        @default(0)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([vendorId, userId])
  @@index([vendorId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Notifications (spec section 17)
// ---------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "ORDER_STATUS" | "PAYMENT" | "PAYOUT" | "VENDOR_STATUS" | "REVIEW" | "LOW_STOCK" | ...
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------
// Shipping (spec section 12) — kept intentionally simple for Phase 2:
// flat-rate methods, optionally scoped to a zone, always scoped to a
// vendor (each vendor sets their own shipping options). Real courier
// integration is a documented Phase 4 extension point.
// ---------------------------------------------------------------------

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  countries String[] @default([])
  createdAt DateTime @default(now())

  methods   ShippingMethod[]
}

model ShippingMethod {
  id                String        @id @default(cuid())
  vendorId          String
  vendor            VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zoneId            String?
  zone              ShippingZone? @relation(fields: [zoneId], references: [id])

  name              String        // e.g. "Standard", "Express"
  cost              Decimal       @db.Decimal(12, 2)
  estimatedDaysMin  Int?
  estimatedDaysMax  Int?
  isActive          Boolean       @default(true)
  isDefault         Boolean       @default(false)

  vendorOrders      VendorOrder[]

  createdAt         DateTime      @default(now())

  @@index([vendorId])
}

// ---------------------------------------------------------------------
// Returns & Refunds (spec section 13)
// ---------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURN_IN_PROGRESS
  RETURNED
  REFUND_PROCESSING
  REFUNDED
}

model ReturnRequest {
  id            String       @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder  @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User         @relation(fields: [customerId], references: [id])

  reason        String
  description   String?
  images        String[]     @default([])

  status        ReturnStatus @default(REQUESTED)
  adminResponse String?
  refundAmount  Decimal?     @db.Decimal(12, 2)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([vendorOrderId])
  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Coupons & Promotions (spec section 18)
// ---------------------------------------------------------------------

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  PLATFORM
  VENDOR
}

// Business rule (documented since it's a real design decision, not an
// omission): a coupon's discount is funded by the platform, not deducted
// from vendor earnings — commission and vendor payouts are still
// calculated off the pre-discount subtotal, exactly as if the coupon
// didn't exist. Only the amount the customer is actually charged shrinks.
// A vendor-funded coupon variant (where the vendor's own payout absorbs
// the discount) is a natural follow-up that would only touch
// resolveCommissionPercent-adjacent code, not this table.
model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  type        CouponType
  value       Decimal     @db.Decimal(12, 2) // percent (0-100) or fixed amount

  scope       CouponScope @default(PLATFORM)
  vendorId    String?
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])

  minPurchaseAmount Decimal? @db.Decimal(12, 2)
  usageLimit        Int?
  usageCount         Int      @default(0)
  perUserLimit       Int?
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean  @default(true)

  redemptions        CouponRedemption[]

  createdAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([scope])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ---------------------------------------------------------------------
// Real-time-style chat (spec section 16). Implemented as a polled REST
// API (the client refetches on a short interval) rather than a WebSocket
// server, since Next.js API routes are request/response by default and
// standing up a separate WS server is a real infra decision left to the
// deployment target. Swapping the client's polling for a WS/SSE
// subscription later doesn't require changing this schema.
// ---------------------------------------------------------------------

model Conversation {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])

  messages   Message[]

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@unique([customerId, vendorId, productId])
  @@index([vendorId])
  @@index([customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  body           String?
  attachmentUrl  String?
  isRead         Boolean      @default(false)

  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------
// Recently viewed (spec section 5 / 22)
// ---------------------------------------------------------------------

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ---------------------------------------------------------------------
// Loyalty & rewards (spec section 23) — kept modular: earning/redemption
// happen only in the checkout flow and this table, so loyalty rules
// (rate, caps) can change without touching order/commission logic.
// ---------------------------------------------------------------------

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  updatedAt      DateTime @updatedAt

  transactions   LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  type             LoyaltyTransactionType
  points           Int
  orderId          String?
  description      String?
  createdAt        DateTime               @default(now())

  @@index([loyaltyAccountId])
}

// ---------------------------------------------------------------------
// Platform settings (singleton row)
// ---------------------------------------------------------------------

model PlatformSettings {
  id                 String  @id @default("singleton")
  marketplaceName    String  @default("Marketplace")
  defaultCommission  Decimal @default(10) @db.Decimal(5, 2)
  currency           String  @default("LSL")
  maintenanceMode    Boolean @default(false)

  // Loyalty configuration (spec section 23): points earned per currency
  // unit spent, and how many points redeem for one currency unit.
  loyaltyEarnRatePerCurrency  Decimal @default(1) @db.Decimal(6, 2)
  loyaltyRedeemPointsPerUnit  Int     @default(100)

  // Automated vendor payouts (spec section 37, Phase 4). The app itself
  // has no built-in scheduler (Next.js API routes are request/response),
  // so these only take effect when something external — Vercel Cron, an
  // OS cron job, a GitHub Action — calls
  // POST /api/admin/payouts/auto-run on a schedule. See that route's
  // doc comment and the README for the exact setup.
  autoPayoutEnabled   Boolean @default(false)
  autoPayoutThreshold Decimal @default(0) @db.Decimal(12, 2)

  // Rule-based fraud detection (spec section 25/37, Phase 4). An order
  // scoring at or above this is flagged for admin review — it is never
  // auto-blocked, since false positives would wrongly deny real
  // customers. See src/lib/fraud.ts for the scoring rules.
  fraudReviewThreshold Int @default(50)
}

// ---------------------------------------------------------------------
// Audit logs (spec section 26) — every admin/financial action that
// matters writes one row here via src/lib/audit.ts, mirroring how
// notify() is the single choke point for notifications.
// ---------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorEmail     String?
  action         String
  entityType     String
  entityId       String?
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// Multi-currency (spec section 27) — Phase 1's note said the initial
// deployment could stay single-currency without making later
// internationalization impossible. This is that later step, scoped
// honestly: exchange rates are admin-managed and used for *display*
// conversion (shop browsing, product pages) so shoppers can see
// approximate prices in their currency. Actual charging and all
// settlement (Payment, VendorWallet, commission) remain in the
// platform's base currency (PlatformSettings.currency) — real
// multi-currency *charging* would need a payment gateway that itself
// settles in multiple currencies, which is a provider-specific
// capability, not something this schema should hard-code.
// ---------------------------------------------------------------------

model CurrencyRate {
  id           String   @id @default(cuid())
  currencyCode String   @unique // ISO 4217, e.g. "USD", "ZAR"
  rateToBase   Decimal  @db.Decimal(14, 6) // 1 base-currency unit = rateToBase units of this currency
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Rule-based fraud detection (spec section 25/37). Deliberately
// rule-based and documented as such rather than dressed up as "AI" —
// see src/lib/fraud.ts. Flags surface in an admin review queue; nothing
// here blocks a purchase automatically.
// ---------------------------------------------------------------------

enum FraudFlagStatus {
  OPEN
  CLEARED
  CONFIRMED_FRAUD
}

model FraudFlag {
  id         String          @id @default(cuid())
  orderId    String          @unique
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  score      Int
  reasons    String[]
  status     FraudFlagStatus @default(OPEN)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())
}
